---
// Right column: "On this page", then GitHub, help and edit-link cards.
// Replaces Starlight's default PageSidebar (see `components` in astro.config.mjs).
import MobileTableOfContents from 'virtual:starlight/components/MobileTableOfContents';
import TableOfContents from 'virtual:starlight/components/TableOfContents';
import { Icon } from '@astrojs/starlight/components';
import { REPO_URL, repoStars } from '../lib/github';

const { toc, editUrl } = Astro.locals.starlightRoute;
const stars = await repoStars();
---

{toc && (
  <div class="lg:sl-hidden">
    <MobileTableOfContents />
  </div>
)}
<div class="right-column sl-hidden lg:sl-block">
  {toc && (
    <section class="toc">
      <TableOfContents />
    </section>
  )}

  <section>
    <h2>Star on GitHub</h2>
    <a class="star" href={REPO_URL}>
      <span class="star-label"><Icon name="star" size="1rem" /> Star</span>
      {stars && <span class="star-count">{stars}</span>}
    </a>
  </section>

  <section>
    <h2>Can't find what you're looking for?</h2>
    <a class="plain" href={`${REPO_URL}/issues/new`}>Ask on GitHub</a>
  </section>

  {editUrl && (
    <section>
      <a class="plain edit" href={editUrl}>
        Edit this page on GitHub <Icon name="external" size="0.9rem" />
      </a>
    </section>
  )}
</div>

<style>
  .right-column section {
    padding: 1.5rem var(--sl-sidebar-pad-x);
    border-bottom: 1px solid var(--sl-color-hairline);
    width: calc(var(--sl-sidebar-width) - 2 * var(--sl-sidebar-pad-x));
    box-sizing: content-box;
  }
  .right-column section:last-child {
    border-bottom: none;
  }
  .right-column h2 {
    color: var(--sl-color-white);
    font-size: var(--sl-text-lg);
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.25;
    margin-bottom: 0.9rem;
  }
  /* "On this page" — small spaced capitals, as a label */
  .toc :global(h2) {
    font-size: var(--sl-text-xs);
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--sl-color-gray-2);
  }
  .toc :global(a) {
    display: block;
    font-size: var(--sl-text-sm);
    text-decoration: none;
    color: var(--sl-color-gray-3);
    overflow-wrap: anywhere;
  }
  .toc :global(a:hover),
  .toc :global(a[aria-current='true']) {
    color: var(--sl-color-white);
  }
  .star {
    display: inline-flex;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.2rem;
    text-decoration: none;
    font-size: var(--sl-text-sm);
    font-weight: 600;
    color: var(--sl-color-white);
    overflow: hidden;
  }
  .star-label {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    background: var(--sl-color-gray-6);
  }
  .star-count {
    padding: 0.3rem 0.7rem;
    border-left: 1px solid var(--sl-color-gray-5);
  }
  .star:hover .star-label {
    background: var(--sl-color-gray-5);
  }
  .plain {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .plain:hover {
    color: var(--sl-color-white);
  }
</style>
