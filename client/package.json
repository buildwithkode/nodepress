{
  "name": "@nodepress-cms/client",
  "version": "1.7.0",
  "description": "Typed JavaScript/TypeScript client for the NodePress headless CMS",
  "keywords": [
    "cms",
    "headless",
    "nodepress",
    "client",
    "sdk"
  ],
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "author": "BuildWithKode <https://buildwithkode.com>",
  "homepage": "https://nodepress.buildwithkode.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/buildwithkode/nodepress.git",
    "directory": "client"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./preview": {
      "import": {
        "types": "./dist/esm/preview.d.ts",
        "default": "./dist/esm/preview.js"
      },
      "require": {
        "types": "./dist/cjs/preview.d.ts",
        "default": "./dist/cjs/preview.js"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "preview": [
        "./dist/cjs/preview.d.ts"
      ]
    }
  },
  "files": [
    "dist/",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "node ../node_modules/typescript/bin/tsc -p tsconfig.test.json",
    "test": "node scripts/build.js && npm run typecheck && node --test test/client.test.js test/preview.test.js",
    "prepublishOnly": "npm test"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {}
}
