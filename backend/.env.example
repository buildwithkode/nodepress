# NodePress Backend — copy to .env and fill in your values
# The CLI (npx create-nodepress-app) generates this automatically.

# ── Required ──────────────────────────────────────────────────────────────────

# PostgreSQL connection string for the app (use pooled URL if using PgBouncer / Neon)
DATABASE_URL="postgresql://postgres:your_password@localhost:5432/YOUR_NODEPRESS_DATABASE"

# Direct (non-pooled) PostgreSQL URL — required by Prisma migrations.
# If not using a pooler (local Postgres / plain Neon direct URL), set to same as DATABASE_URL.
DIRECT_URL="postgresql://postgres:your_password@localhost:5432/YOUR_NODEPRESS_DATABASE"

# Optional read replica. Public content API reads (GET /api/{type}, /api/{type}/{slug})
# go here; writes, the admin panel and previews always use DATABASE_URL.
# DATABASE_REPLICA_URL="postgresql://postgres:your_password@replica-host:5432/YOUR_NODEPRESS_DATABASE"
# After a write, reads stay on the primary this long so the replica can catch up (ms, default 5000).
# REPLICA_READ_AFTER_WRITE_MS=5000

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace_with_64_char_random_hex

# Allowed origin for the admin panel (no trailing slash).
# Comma-separated for multiple origins: "https://app.com,https://staging.app.com"
CORS_ORIGIN=http://localhost:5173

# ── Optional ──────────────────────────────────────────────────────────────────

PORT=3000
APP_URL=http://localhost:3000
SITE_URL=http://localhost:5173

# Access token lifetime (default 7d). Refresh tokens always last 30 days (HttpOnly cookie, rotated on use).
# JWT_EXPIRES_IN=7d

# Logging level (debug | info | warn | error). Default: debug in dev, info in prod.
# LOG_LEVEL=info

# ── Redis ─────────────────────────────────────────────────────────────────────
# Optional for one instance, required for more than one. When set:
#   - AppCacheService uses Redis instead of in-memory Map (shared across instances)
#   - Rate-limit counters are shared, so N replicas don't allow N× the limit
#   - Socket.io uses the Redis adapter (real-time events sync across all instances)
# REDIS_URL=redis://localhost:6379

# ── Reverse proxy ─────────────────────────────────────────────────────────────
# Which proxies may set X-Forwarded-For. The default trusts private networks only
# (Docker nginx, k8s ingress), so req.ip is the real client for rate limiting and
# audit logs. Behind a CDN on a public IP (Cloudflare → nginx), use a hop count.
# TRUST_PROXY=loopback, linklocal, uniquelocal

# ── S3 media storage ──────────────────────────────────────────────────────────
# Leave blank to store files locally in backend/uploads/
# STORAGE_DRIVER=s3
# STORAGE_S3_BUCKET=my-bucket
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY=
# STORAGE_S3_SECRET_KEY=
# STORAGE_S3_ENDPOINT=               # only needed for R2 / MinIO / Backblaze
# STORAGE_S3_PUBLIC_URL=             # CDN domain for public file URLs

# ── Email ─────────────────────────────────────────────────────────────────────
# Required for: password reset links, user invitation emails, form email actions.
# Without SMTP in development, the reset link is shown directly in the browser UI (no terminal digging).
# Without SMTP in production, password reset silently does nothing — configure SMTP before going live.
#
# Gmail setup: Gmail rejects your normal password over SMTP — you need a 16-char App Password.
#   1. Enable 2-Step Verification: https://myaccount.google.com/signinoptions/two-step-verification
#   2. Create an App Password:      https://myaccount.google.com/apppasswords  (choose Mail / Other)
#   3. Use that 16-char value (no spaces) as SMTP_PASS below.
#   Gmail is fine for testing (~500 msgs/day cap). For production use a provider like
#   Resend / Brevo / Mailgun / SendGrid / Postmark — same five vars, better deliverability.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false                  # true for port 465 (SSL), false for 587 (STARTTLS)
# SMTP_USER=you@gmail.com
# SMTP_PASS=your_16_char_app_password  # Gmail App Password (https://myaccount.google.com/apppasswords) — NOT your login password
# SMTP_FROM=NodePress <noreply@yourdomain.com>
#
# Form-submission emails are branded from the in-app Brand page (Settings → Brand:
# name, logo, accent colour) — stored in the database, no env vars needed. Field
# rows use each field's label automatically.

# ── Spam protection — captcha for public form submissions ──────────────────────
# Each provider gives you TWO keys — do not swap them:
#   • Site Key   → goes in your WEBSITE form HTML (the widget's data-sitekey). Public. NOT here.
#   • Secret Key → goes BELOW as CAPTCHA_SECRET_KEY. Private — never put it in frontend code or git.
# Then toggle per-form: turn on the "Spam Protection (Captcha)" switch (captchaEnabled=true).
# Frontend: render the captcha widget and pass its token as `captchaToken` in the submit body.
# Note: setting CAPTCHA_PROVIDER without CAPTCHA_SECRET_KEY stops the backend from starting.
#
# Providers:
#   turnstile  — Cloudflare Turnstile (recommended — invisible, no user puzzle)
#                Dashboard: https://dash.cloudflare.com/?to=/:account/turnstile
#   hcaptcha   — hCaptcha
#                Dashboard: https://dashboard.hcaptcha.com/
#   recaptcha  — Google reCAPTCHA v2 or v3
#                Dashboard: https://www.google.com/recaptcha/admin/create
#
# CAPTCHA_PROVIDER=turnstile
# CAPTCHA_SECRET_KEY=0x4AAAAAAA...your_server_secret_here

# ── Audit log ─────────────────────────────────────────────────────────────────
# How many days to keep audit log entries (default 90). Pruned weekly on Sunday 03:00 UTC.
# AUDIT_LOG_RETENTION_DAYS=90

# ── Single sign-on (OpenID Connect) ───────────────────────────────────────────
# Google Workspace, Microsoft Entra ID, Okta, Auth0, Keycloak… Enabled when
# OIDC_ISSUER is set. Register <SITE_URL>/api/auth/oidc/callback with the provider.
# OIDC_ISSUER=https://accounts.google.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_PROVIDER_NAME=Google
# OIDC_SCOPES=openid email profile
# OIDC_ALLOWED_DOMAINS=acme.com            # comma-separated; empty = any domain
# OIDC_AUTO_CREATE=false                   # true = create accounts on first sign-in
# OIDC_DEFAULT_ROLE=viewer                 # admin | editor | contributor | viewer
# OIDC_ROLE_CLAIM=groups                   # claim holding group/role names
# OIDC_ROLE_MAP=cms-admins:admin,cms-editors:editor
# OIDC_REDIRECT_URI=                       # override the default callback URL

# ── Image transforms ──────────────────────────────────────────────────────────
# GET /api/media/:file/transform — encodes run at most this many at once, and
# cached variants are pruned nightly (unused 30 days, LRU above the cap).
# IMAGE_TRANSFORM_CONCURRENCY=2
# IMAGE_VARIANT_CACHE_MB=2048

# ── CDN caching ───────────────────────────────────────────────────────────────
# Public published reads carry Cache-Tag / Surrogate-Key headers (np-all,
# np-ct-<id>). With a purge driver, every write purges just the changed content
# types, so a CDN can cache for an hour and still update within seconds.
# CDN_PURGE_DRIVER=none        # none | cloudflare | fastly | webhook
# CDN_CACHE_TTL=3600           # s-maxage; default 3600 with a driver, 30 without
# CLOUDFLARE_ZONE_ID=
# CLOUDFLARE_API_TOKEN=        # Zone → Cache Purge permission
# FASTLY_SERVICE_ID=
# FASTLY_API_TOKEN=            # purge_select scope
# CDN_PURGE_WEBHOOK_URL=       # POST {event,tags,timestamp}
# CDN_PURGE_WEBHOOK_SECRET=    # signs the body: X-NodePress-Signature: sha256=<hmac>

# ── Background queues ─────────────────────────────────────────────────────────
# Webhook deliveries (webhook_deliveries table) and background jobs such as form
# email/webhook actions (jobs table) are queued in Postgres. Every backend
# instance runs workers that claim due work (FOR UPDATE SKIP LOCKED), so adding
# instances adds capacity. Set QUEUE_WORKER=false on instances that should only
# serve the API (e.g. when running dedicated worker instances).
# QUEUE_WORKER=true
# QUEUE_POLL_MS=1000           # how often an idle worker checks for due work
# WEBHOOK_CONCURRENCY=10       # webhook deliveries in flight per instance
# JOB_CONCURRENCY=5            # jobs (form emails/webhooks) in flight per instance

# ── Public form submission guardrails ─────────────────────────────────────────
# Abuse protection applied to every POST /api/submit/:slug before validation.
# Defaults shown; raise/lower per your needs.
# FORM_MAX_DEPTH=3              # max object/array nesting in a submission
# FORM_MAX_ARRAY_ITEMS=100     # max items allowed in any single array field
# FORM_MAX_FIELDS=200          # max total fields after flattening nested data
# FORM_MAX_PAYLOAD_BYTES=102400 # max JSON body size in bytes (~100 KB)

# ── Error tracking (Sentry) ───────────────────────────────────────────────────
# SENTRY_DSN=https://your_key@sentry.io/your_project_id

# ── Prometheus metrics auth ───────────────────────────────────────────────────
# Protects GET /api/metrics with a Bearer token. Leave blank for unauthenticated access.
# METRICS_TOKEN=replace_with_random_secret

# GET /api/health reports memory "down" (HTTP 503) above this heap size in MB.
# Default: 90% of the V8 heap limit (set via NODE_OPTIONS=--max-old-space-size).
# HEALTH_MAX_HEAP_MB=

# ── robots.txt ────────────────────────────────────────────────────────────────
# Comma-separated paths to add as Disallow rules in /api/robots.txt
# ROBOTS_DISALLOW=/admin,/api/private
