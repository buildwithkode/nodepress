{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": "\\.e2e-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": {
          "esModuleInterop": true,
          "allowJs": true,
          "isolatedModules": true
        }
      }
    ]
  },
  "moduleNameMapper": {
    "^src/(.*)$": "<rootDir>/../src/$1",
    "^@nodepress/plugin-sdk$": "<rootDir>/../src/plugin/plugin-sdk",
    "^(\\.{1,2}/.*)\\.js$": "$1"
  },
  "modulePaths": [
    "<rootDir>/../node_modules",
    "<rootDir>/../../node_modules"
  ],
  "setupFiles": [
    "<rootDir>/jest.setup.ts"
  ],
  "testTimeout": 60000,
  "globals": {
    "ts-jest": {
      "tsconfig": "<rootDir>/../tsconfig.json"
    }
  },
  "transformIgnorePatterns": [
    "node_modules/(?!.*(htmlparser2|domutils|domhandler|domelementtype|dom-serializer|entities))"
  ]
}
