# NodePress — Root environment variables (for Docker Compose & Hostinger One-Click Deploy)
# For local dev without Docker, configure backend/.env and frontend/.env.local directly.

POSTGRES_DB=nodepress
POSTGRES_USER=postgres

# Secrets — leave these commented out to have docker-compose.yml generate random
# values on first boot (stored in the `secrets_data` volume). Set them only to use
# your own values. Never use a placeholder: anything ≥32 chars passes validation.
# DB_PASSWORD=
# JWT_SECRET=

# Defaults to SITE_URL when unset.
# CORS_ORIGIN=http://localhost
APP_URL=http://localhost
SITE_URL=http://localhost
