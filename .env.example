# NodePress — Root environment variables (for Docker Compose & Hostinger One-Click Deploy)
# For local dev without Docker, configure backend/.env and frontend/.env.local directly.

POSTGRES_DB=nodepress
POSTGRES_USER=postgres
DB_PASSWORD=your_secure_db_password
JWT_SECRET=replace_with_64_char_random_hex
CORS_ORIGIN=http://localhost
APP_URL=http://localhost/api
SITE_URL=http://localhost
