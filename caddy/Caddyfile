# Automatic HTTPS for NodePress (docker-compose.https.yml).
# Caddy gets and renews a Let's Encrypt certificate for $DOMAIN and forwards
# everything to nginx, which keeps its routing, rate limits and realtime rules.
# The DNS A/AAAA record for $DOMAIN must point at this server, with ports 80
# and 443 open, before the first start.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	reverse_proxy nginx:80
}

# Redirect the www. variant to the bare domain.
www.{$DOMAIN} {
	redir https://{$DOMAIN}{uri} permanent
}
