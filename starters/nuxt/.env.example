# The NodePress backend (not the admin), e.g. https://cms.example.com — read by the
# Nuxt server at runtime (`nuxt dev` loads this file; in production set real env vars).
NODEPRESS_URL=http://localhost:3000
# Content type to list. The "Blog" starter template in NodePress creates `post`.
NODEPRESS_TYPE=blog
# Relation fields to inline (comma-separated, dot paths for nested). Empty = none.
NODEPRESS_POPULATE=author
# Optional read API key — stays on the server, never sent to the browser.
NODEPRESS_API_KEY=
